---
import type { StateRecord, OffenceRecord } from '../lib/schemas';
import { shortSection } from '../lib/format';
interface Props { offences: OffenceRecord[]; state?: StateRecord; compact?: boolean }
const { offences, state, compact = false } = Astro.props;
const stateLabel = state ? `In ${state.name}` : '';
---
<div class="table-wrap">
<table class="schedule">
  <thead>
    <tr>
      <th>Offence</th>
      {!compact && <th>Section</th>}
      <th>First offence</th>
      {!compact && <th>Repeat</th>}
      {!compact && state && <th>{stateLabel}</th>}
    </tr>
  </thead>
  <tbody>
    {offences.map((o) => {
      const override = state ? state.fine_overrides[o.slug] : undefined;
      return (
        <tr data-severity={o.compoundable_online ? 'standard' : 'court'}>
          <td>
            <a href={`/fines/${o.slug}/`}>{o.name}</a>
            {!o.compoundable_online && <span class="tag tag--danger">Court</span>}
          </td>
          {!compact && <td data-label="Section">{shortSection(o.mva_section)}</td>}
          <td class="amount-cell" data-label="First offence">{o.base_fine_text}</td>
          {!compact && <td class="amount-cell" data-label="Repeat">{o.repeat_fine_text}</td>}
          {!compact && state && (
            <td class="amount-cell" data-label={stateLabel} data-override={override ? 'true' : 'false'}>
              {override?.amount_text ?? 'Standard amount'}
              {override && <span class="tag tag--attention">State-notified</span>}
            </td>
          )}
        </tr>
      );
    })}
  </tbody>
</table>
</div>
