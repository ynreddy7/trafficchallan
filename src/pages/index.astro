---
import Base from '../layouts/Base.astro';
import AnswerBox from '../components/AnswerBox.astro';
import FineTable from '../components/FineTable.astro';
import FaqSection from '../components/FaqSection.astro';
import LastVerified from '../components/LastVerified.astro';
import PlateBadge from '../components/PlateBadge.astro';
import { loadStates, loadOffences, newestVerifiedDate } from '../lib/data';
import { faqJsonLd } from '../lib/seo';
import { firstSentence } from '../lib/format';
import { getCollection } from 'astro:content';

const states = [...loadStates()].sort((a, b) => a.name.localeCompare(b.name));
const allOffences = loadOffences();

/** RTO series prefix per state slug — state code only, never a full plate. */
const STATE_CODES: Record<string, string> = {
  delhi: 'DL',
  telangana: 'TS',
  maharashtra: 'MH',
  'uttar-pradesh': 'UP',
  karnataka: 'KA',
  'tamil-nadu': 'TN',
  'andhra-pradesh': 'AP',
  haryana: 'HR',
  rajasthan: 'RJ',
  gujarat: 'GJ',
  'west-bengal': 'WB',
  'madhya-pradesh': 'MP',
  'jammu-kashmir': 'JK'
};

/** RTO series code → state slug, for the vehicle-number portal finder.
 * One entry per code — Telangana carries both TS (legacy) and TG (current). */
const RTO_CODE_TO_SLUG: Record<string, string> = {
  AP: 'andhra-pradesh',
  DL: 'delhi',
  GJ: 'gujarat',
  HR: 'haryana',
  JK: 'jammu-kashmir',
  KA: 'karnataka',
  MP: 'madhya-pradesh',
  MH: 'maharashtra',
  RJ: 'rajasthan',
  TN: 'tamil-nadu',
  TS: 'telangana',
  TG: 'telangana',
  UP: 'uttar-pradesh',
  WB: 'west-bengal'
};

const stateBySlug = new Map(states.map((s) => [s.slug, s]));
const rtoStates = Object.entries(RTO_CODE_TO_SLUG)
  .map(([code, slug]) => {
    const s = stateBySlug.get(slug);
    return s ? { code, slug, name: s.name } : null;
  })
  .filter((x): x is { code: string; slug: string; name: string } => x !== null);

const finderData = {
  rtoStates,
  states: states.map((s) => ({
    slug: s.slug,
    name: s.name,
    portals: s.portals.map((p) => ({ label: p.label, url: p.url, scope: p.scope })),
    courtNote: firstSentence(s.court_challan_process)
  }))
};

const topSlugs = [
  'driving-without-helmet',
  'driving-without-insurance',
  'driving-without-licence',
  'drunk-driving',
  'overspeeding',
  'mobile-phone-while-driving'
];
const topOffences = topSlugs
  .map((slug) => allOffences.find((o) => o.slug === slug))
  .filter((o): o is (typeof allOffences)[number] => Boolean(o));

const guideOrder = [
  'how-to-check-e-challan',
  'how-to-pay-e-challan-online',
  'unpaid-e-challan-consequences',
  'wrong-e-challan-dispute',
  'e-challan-lok-adalat',
  'court-challan-vs-on-spot-challan'
];
const allGuides = await getCollection('guides');
const guides = guideOrder
  .map((id) => allGuides.find((g) => g.id === id))
  .filter((g): g is (typeof allGuides)[number] => Boolean(g));

const newestVerified = newestVerifiedDate();

const year = new Date().getFullYear();

const faqs = [
  {
    q: 'Is trafficchallan.com an official government website?',
    a: 'No. TrafficChallan is an independent information site and is not affiliated with the Ministry of Road Transport, Parivahan, or any state police or transport department. We link directly to the official portals for checking and paying challans.'
  },
  {
    q: 'Can I pay my e-challan on this website?',
    a: 'No. Payment happens only on the official government portal for your state — usually echallan.parivahan.gov.in, the NextGen portal, or your state transport or police site — which we link to from every state page.'
  },
  {
    q: 'How current is the fine and portal information here?',
    a: 'Every page states the date it was last checked against its official source. Fine amounts and portal details are re-verified on a rolling cycle and updated as soon as a government notification changes them.'
  },
  {
    q: 'What is an e-challan?',
    a: 'An e-challan is an electronically generated traffic violation notice issued by police through a traffic camera or handheld device. It records the vehicle number, offence, section of law and fine amount, and can usually be checked and paid online.'
  }
];

const description = `Check and pay traffic e-challans online for all ${states.length} Indian states — official portals, current fine amounts and dispute steps. Independently verified ${year}.`;
---
<Base
  title="Check & Pay Traffic e-Challan Online in India"
  description={description}
  path="/"
  jsonld={[faqJsonLd(faqs)]}
  dateModified={newestVerified}
>
  <div class="hero">
    <h1>Check &amp; pay traffic e-challan online — every Indian state</h1>
    <AnswerBox>
      Most states route e-challans through the national portal
      <a href="https://echallan.parivahan.gov.in/" rel="noopener">echallan.parivahan.gov.in</a>, though a growing
      number now use the newer <a href="https://echallan.parivahan.nic.in/" rel="noopener">NextGen portal</a> or
      their own state site instead. Enter your vehicle registration number on the right portal to see pending
      challans and pay online. The two busiest pages on this site are
      <a href="/telangana-e-challan/">Telangana e-challan</a> and <a href="/delhi-e-challan/">Delhi e-challan</a> —
      or pick your own state below.
    </AnswerBox>

    <div class="actions">
      <a class="action action--primary" href="#portal-finder">
        Find your challan portal
        <svg class="action__chev" width="11" height="15" viewBox="0 0 13 17" aria-hidden="true" focusable="false"><path d="M0 0h5.4L13 8.5 5.4 17H0l7.6-8.5z" fill="currentColor"/></svg>
      </a>
      <a class="action action--secondary" href="/calculator/">
        Know your fine
        <svg class="action__chev" width="11" height="15" viewBox="0 0 13 17" aria-hidden="true" focusable="false"><path d="M0 0h5.4L13 8.5 5.4 17H0l7.6-8.5z" fill="currentColor"/></svg>
      </a>
    </div>

    <ul class="stat-strip">
      <li><b>{states.length}</b> states</li>
      <li><b>{allOffences.length}</b> offences</li>
      <li>Sourced &amp; dated</li>
    </ul>
  </div>

  <section id="portal-finder" class="panel">
    <h2>Find your challan portal</h2>
    <p>
      Type your vehicle number (e.g. <strong>MH12AB1234</strong>) or your state name — nothing you type here leaves
      your browser — to see the exact official portal for your state, whether it covers checking, paying or both,
      and how court challans work there.
    </p>

    <form id="finder-form" class="finder-form">
      <label for="finder-input">Your vehicle number or state</label>
      <input type="text" id="finder-input" autocomplete="off" placeholder="MH12AB1234 or Maharashtra" />
      <button type="submit" class="action action--primary">Find portal</button>
    </form>

    <div id="finder-result" class="finder-result" aria-live="polite"></div>

    <noscript>
      <p>
        Most states check and pay through <a href="https://echallan.parivahan.gov.in/" rel="noopener">echallan.parivahan.gov.in</a>;
        the rest have moved to the <a href="https://echallan.parivahan.nic.in/" rel="noopener">NextGen portal</a> or run their own
        state site — pick your state below for the exact one.
      </p>
    </noscript>
  </section>

  <script type="application/json" id="finder-data" set:html={JSON.stringify(finderData)} />
  <script>
    import { resolveVehicleInput, type RtoStateEntry } from '../lib/portal-finder';

    interface FinderPortal { label: string; url: string; scope: 'check' | 'pay' | 'both' }
    interface FinderState { slug: string; name: string; portals: FinderPortal[]; courtNote: string }
    interface FinderData { rtoStates: RtoStateEntry[]; states: FinderState[] }

    const data: FinderData = JSON.parse(document.getElementById('finder-data')!.textContent!);
    const stateBySlug = new Map(data.states.map((s) => [s.slug, s]));
    const form = document.getElementById('finder-form') as HTMLFormElement;
    const input = document.getElementById('finder-input') as HTMLInputElement;
    const result = document.getElementById('finder-result') as HTMLDivElement;

    const SCOPE_LABEL: Record<FinderPortal['scope'], string> = { check: 'Check', pay: 'Pay', both: 'Both' };

    function externalLink(href: string, label: string): HTMLAnchorElement {
      const a = document.createElement('a');
      a.href = href;
      a.rel = 'noopener';
      a.textContent = label + ' ';
      const ext = document.createElement('span');
      ext.className = 'ext';
      ext.setAttribute('aria-hidden', 'true');
      ext.textContent = '↗';
      a.appendChild(ext);
      return a;
    }

    function renderState(state: FinderState) {
      result.replaceChildren();
      const wrap = document.createElement('div');
      wrap.className = 'panel';

      const h3 = document.createElement('h3');
      h3.textContent = state.name;
      wrap.appendChild(h3);

      const ul = document.createElement('ul');
      for (const p of state.portals) {
        const li = document.createElement('li');
        li.appendChild(externalLink(p.url, p.label));
        const chip = document.createElement('span');
        chip.className = `chip chip--${p.scope}`;
        chip.textContent = SCOPE_LABEL[p.scope];
        li.appendChild(chip);
        ul.appendChild(li);
      }
      wrap.appendChild(ul);

      const note = document.createElement('p');
      note.className = 'verified';
      note.textContent = state.courtNote;
      wrap.appendChild(note);

      const full = document.createElement('p');
      const a = document.createElement('a');
      a.href = `/${state.slug}-e-challan/`;
      a.className = 'action action--secondary';
      a.textContent = `Full ${state.name} e-challan guide`;
      full.appendChild(a);
      wrap.appendChild(full);

      result.appendChild(wrap);
    }

    function renderUnknownCode(code: string) {
      result.replaceChildren();
      const wrap = document.createElement('div');
      wrap.className = 'panel';
      const p = document.createElement('p');
      p.textContent = `We don't have a dedicated ${code} guide yet — use the national portal:`;
      wrap.appendChild(p);
      const ul = document.createElement('ul');
      const li1 = document.createElement('li');
      li1.appendChild(externalLink('https://echallan.parivahan.gov.in/', 'echallan.parivahan.gov.in'));
      ul.appendChild(li1);
      const li2 = document.createElement('li');
      li2.appendChild(externalLink('https://echallan.parivahan.nic.in/', 'echallan.parivahan.nic.in (NextGen)'));
      ul.appendChild(li2);
      wrap.appendChild(ul);
      const rto = document.createElement('p');
      const rtoLink = document.createElement('a');
      rtoLink.href = '/rto-codes/';
      rtoLink.textContent = `Which city is ${code} from? See the full RTO code lookup`;
      rto.appendChild(rtoLink);
      wrap.appendChild(rto);
      result.appendChild(wrap);
    }

    function renderInvalid() {
      result.replaceChildren();
      const wrap = document.createElement('div');
      wrap.className = 'panel';
      const p = document.createElement('p');
      p.textContent = "We couldn't recognise that — try a vehicle number like MH12AB1234, or type your state name.";
      wrap.appendChild(p);
      result.appendChild(wrap);
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const value = input.value;
      const resolved = resolveVehicleInput(value, data.rtoStates);
      if (resolved.kind === 'state') {
        const state = stateBySlug.get(resolved.slug);
        if (state) renderState(state);
        else renderInvalid();
      } else if (resolved.kind === 'unknown-code') {
        renderUnknownCode(resolved.code);
      } else {
        renderInvalid();
      }
    });
  </script>

  <h2>Check your state</h2>
  <p>
    Every state page has its official check-and-pay portals, step-by-step instructions, SMS/app options,
    court-challan process and any state-specific fine amounts.
  </p>
  <div class="gantry">
    <ul class="state-grid">
      {states.map((s) => (
        <li>
          <a href={`/${s.slug}-e-challan/`}>
            {STATE_CODES[s.slug] && <PlateBadge code={STATE_CODES[s.slug]} />}
            <span class="state-name">{s.name}</span>
            <svg class="action__chev" width="8" height="11" viewBox="0 0 13 17" aria-hidden="true" focusable="false"><path d="M0 0h5.4L13 8.5 5.4 17H0l7.6-8.5z" fill="currentColor"/></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <h2>Common traffic fines</h2>
  <p>
    The offences drivers look up most often. See the <a href="/fines/">full fine list</a> for every offence, the
    <a href="/calculator/">fine calculator</a> to total a multi-offence challan, or
    <a href="/compare/">compare fines across states</a> where amounts differ from the central Motor Vehicles Act.
  </p>
  <FineTable offences={topOffences} compact />

  <h2>Guides</h2>
  <ul class="guide-list">
    <li>
      <a href="/challan-discount/">Is there a challan discount on right now?</a>
      <p class="verified">Live state-by-state tracker of discount and amnesty schemes, Lok Adalat dates and the rumours to skip.</p>
    </li>
    <li>
      <a href="/rto-codes/">Which city is that number plate from?</a>
      <p class="verified">Type any number plate to decode it — every RTO code across all 36 states and union territories, verified and dated.</p>
    </li>
    <li>
      <a href="/challan-status/">What does your e-challan status mean?</a>
      <p class="verified">Pending, Disposed, Sent to Court, Cognizance Denied — every official status decoded, with sourced next steps.</p>
    </li>
    <li>
      <a href="/fake-challan-sms/">Is that challan SMS real?</a>
      <p class="verified">The 60-second check, the verified allow-list of every official challan portal, and the documented scam signals.</p>
    </li>
    {guides.map((g) => (
      <li>
        <a href={`/${g.id}/`}>{g.data.title}</a>
        <p class="verified">{g.data.description}</p>
      </li>
    ))}
  </ul>

  <h2>Why trust this site</h2>
  <p>
    TrafficChallan is an independent reference, not a government website — we never process payments or collect
    challan or vehicle data ourselves. Every fine amount, legal section and portal link here is sourced from an
    official notification or government portal, and every page carries a dated "last verified" line so you can
    see exactly how current it is. Read our <a href="/editorial-policy/">editorial policy</a> for how we source
    facts and correct errors.
  </p>
  <LastVerified date={newestVerified} />

  <FaqSection faqs={faqs} />
</Base>
