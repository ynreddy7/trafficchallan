---
import Base from '../layouts/Base.astro';
import AnswerBox from '../components/AnswerBox.astro';
import LastVerified from '../components/LastVerified.astro';
import SourceList from '../components/SourceList.astro';
import FaqSection from '../components/FaqSection.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import StepList from '../components/StepList.astro';
import FineTable from '../components/FineTable.astro';
import { loadStates, loadOffences } from '../lib/data';
import { faqJsonLd, howToJsonLd } from '../lib/seo';
import { relatedForState } from '../lib/links';
import { slugify } from '../lib/format';
import type { StateRecord } from '../lib/schemas';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const statePaths = loadStates().map((state) => ({
    params: { slug: `${state.slug}-e-challan` },
    props: { type: 'state' as const, state, guide: undefined }
  }));
  const guides = await getCollection('guides');
  const guidePaths = guides.map((guide) => ({
    params: { slug: guide.id },
    props: { type: 'guide' as const, state: undefined, guide }
  }));
  return [...statePaths, ...guidePaths];
}

type Props =
  | { type: 'state'; state: StateRecord; guide: undefined }
  | { type: 'guide'; state: undefined; guide: CollectionEntry<'guides'> };

const props = Astro.props;
const offences = loadOffences();
const guideSlugs = (await getCollection('guides')).map((g) => g.id);
const year = new Date().getFullYear();

const { Content } = props.type === 'guide' ? await render(props.guide) : { Content: null };
---
{props.type === 'state' ? (
  <Base
    title={`${props.state.name} e-Challan ${year}: Check Status & Pay Online`}
    description={`How to check and pay ${props.state.name} traffic e-challans online — official portals, step-by-step process, fine amounts and FAQs. Independently verified.`}
    path={`/${props.state.slug}-e-challan/`}
    jsonld={[howToJsonLd(`How to check ${props.state.name} e-challan`, props.state.check_steps), faqJsonLd(props.state.faqs)]}
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: `${props.state.name} e-Challan`, path: `/${props.state.slug}-e-challan/` }]}
    dateModified={props.state.last_verified}
  >
    <h1>{props.state.name} e-Challan: Check Status &amp; Pay Online</h1>
    <AnswerBox>
      To check a traffic challan in {props.state.name}, enter your vehicle number on
      <a href={props.state.portals[0].url} rel="noopener">{props.state.portals[0].label}</a> or the national portal
      <a href="https://echallan.parivahan.gov.in/" rel="noopener">echallan.parivahan.gov.in</a>.
      Payment is done on the same official portal via {props.state.payment_methods.join(', ')}.
    </AnswerBox>
    <LastVerified date={props.state.last_verified} />

    <h2 id={slugify(`How to check your ${props.state.name} challan`)}>How do I check a {props.state.name} challan?</h2>
    <StepList steps={props.state.check_steps} />

    <h2 id={slugify(`How to pay a ${props.state.name} challan online`)}>How do I pay a {props.state.name} challan online?</h2>
    <StepList steps={props.state.pay_steps} />

    <h2 id={slugify(`Official portals for ${props.state.name}`)}>Which official portals serve {props.state.name}?</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>Portal</th><th>Use for</th></tr></thead>
      <tbody>{props.state.portals.map((p) => <tr><td><a href={p.url} rel="noopener">{p.label}</a></td><td>{p.scope === 'both' ? 'Check & pay' : p.scope}</td></tr>)}</tbody>
    </table></div>

    {props.state.sms_app_methods.length > 0 && <>
      <h2 id={slugify('Check by SMS or app')}>Check by SMS or app</h2>
      <ul>{props.state.sms_app_methods.map((m) => <li>{m}</li>)}</ul>
    </>}

    <h2 id={slugify(`Court challans in ${props.state.name}`)}>What happens with court challans in {props.state.name}?</h2>
    <p>{props.state.court_challan_process}</p>

    <h2 id={slugify(`Traffic fine amounts in ${props.state.name}`)}>What are the traffic fine amounts in {props.state.name}?</h2>
    <FineTable offences={offences} state={props.state} />

    {props.state.quirks.length > 0 && <>
      <h2 id={slugify(`Things specific to ${props.state.name}`)}>Things specific to {props.state.name}</h2>
      <ul>{props.state.quirks.map((q) => <li>{q}</li>)}</ul>
    </>}

    <RelatedLinks items={relatedForState(props.state, offences, guideSlugs)} />
    <FaqSection faqs={props.state.faqs} />
    <SourceList sources={props.state.sources} />
  </Base>
) : (
  <Base
    title={props.guide.data.title}
    description={props.guide.data.description}
    path={`/${props.guide.id}/`}
    jsonld={props.guide.data.faqs.length ? [faqJsonLd(props.guide.data.faqs)] : []}
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: props.guide.data.title, path: `/${props.guide.id}/` }]}
    dateModified={props.guide.data.last_verified}
  >
    <h1>{props.guide.data.title}</h1>
    <LastVerified date={props.guide.data.last_verified} />
    {Content && <Content />}
    {props.guide.data.faqs.length > 0 && <FaqSection faqs={props.guide.data.faqs} />}
    <SourceList sources={props.guide.data.sources} />
  </Base>
)}
