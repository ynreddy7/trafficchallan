---
import Base from '../../layouts/Base.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import LastVerified from '../../components/LastVerified.astro';
import SourceList from '../../components/SourceList.astro';
import FaqSection from '../../components/FaqSection.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import CautionCallout from '../../components/CautionCallout.astro';
import { loadStates, loadOffences, fineListDate } from '../../lib/data';
import { faqJsonLd, offenceTitle, fineAmountShort, lowerSeoName, fineListTitle, fineListH1 } from '../../lib/seo';
import { shortSection, slugify } from '../../lib/format';
import { relatedForOffence, relatedForFineList } from '../../lib/links';
import { hasFineListPage, fineListRows } from '../../lib/fine-list';
import type { OffenceRecord, StateRecord } from '../../lib/schemas';
import { getCollection } from 'astro:content';

// One dynamic route serves two page types (a sibling [state].astro next to
// [offence].astro would be a route collision — Astro cannot rank two dynamic
// segments at the same level): offence pages for every record in data/fines/,
// and per-state fine-list pages for every state with at least one verified
// fine_override (src/lib/fine-list.ts#hasFineListPage). The gate claims both
// slug sets in one registry, so a state slug can never shadow an offence slug.
export async function getStaticPaths() {
  const offencePaths = loadOffences().map((offence) => ({
    params: { slug: offence.slug },
    props: { type: 'offence' as const, offence, state: undefined }
  }));
  const statePaths = loadStates().filter(hasFineListPage).map((state) => ({
    params: { slug: state.slug },
    props: { type: 'state' as const, state, offence: undefined }
  }));
  return [...offencePaths, ...statePaths];
}

type Props =
  | { type: 'offence'; offence: OffenceRecord; state: undefined }
  | { type: 'state'; state: StateRecord; offence: undefined };

const props = Astro.props;
const states = loadStates();
const offences = loadOffences();
// Sorted by slug so the guide-link rotation in links.ts is stable across builds.
const guideRefs = (await getCollection('guides'))
  .map((g) => ({ slug: g.id, title: g.data.title }))
  .sort((a, b) => a.slug.localeCompare(b.slug));
const year = new Date().getFullYear();

// --- Offence-page derivations (empty on state-list pages) -----------------
const overriding = props.type === 'offence' ? states.filter((s) => props.offence.slug in s.fine_overrides) : [];
const offenceTitleStr = props.type === 'offence'
  ? offenceTitle(props.offence.seo_name, props.offence.base_fine_min, props.offence.base_fine_max, year)
  : '';
// Mid-sentence form of the compact amount ("Up to ₹10,000" → "up to ₹10,000").
const amountInline = props.type === 'offence'
  ? fineAmountShort(props.offence.base_fine_min, props.offence.base_fine_max).replace(/^Up to/, 'up to')
  : '';

// --- State fine-list derivations (empty on offence pages) -----------------
// Everything below is data-derived: the amounts, counts, sources and FAQ
// answers come from the state's fine_overrides and the offence files only.
const listRows = props.type === 'state' ? fineListRows(props.state, offences) : [];
const listOverridden = listRows.filter((r) => r.overridden);
const listStatutoryCount = listRows.length - listOverridden.length;
const listDate = props.type === 'state' ? fineListDate(props.state, offences) : '';
// Sources: the override source URLs first (the state's own notifications),
// then every fine file's sources, deduped.
const listSources = props.type === 'state'
  ? [...new Set([
      ...Object.values(props.state.fine_overrides).map((o) => o.source),
      ...offences.flatMap((o) => o.sources)
    ])]
  : [];
let listFaqs: { q: string; a: string }[] = [];
if (props.type === 'state') {
  const s = props.state;
  listFaqs = [
    {
      q: `Are traffic fines different in ${s.name}?`,
      a: `Yes, for ${listOverridden.length} of the ${listRows.length} offences listed here: ${s.name} has notified its own amount for each of those, marked "State-notified" in the table.` +
        (listStatutoryCount > 0
          ? ` The other ${listStatutoryCount} follow the statutory Motor Vehicles Act schedule.`
          : '')
    },
    {
      q: `Which offences does ${s.name} set its own amount for?`,
      a: `${listOverridden.map((r) => r.name).join('; ')}.` +
        (listStatutoryCount > 0
          ? ` Every other offence in the table carries the statutory amount — we have not verified a separate ${s.name} notification for those.`
          : '')
    }
  ];
  const helmet = offences.find((o) => o.slug === 'driving-without-helmet');
  if (helmet) {
    const helmetOverride = s.fine_overrides[helmet.slug];
    listFaqs.push({
      q: `What is the helmet fine in ${s.name}?`,
      a: helmetOverride
        ? `${s.name} has notified its own amount for riding without a helmet: ${helmetOverride.amount_text}`
        : `We have not verified a separate ${s.name} notification for riding without a helmet, so the statutory amount applies: ${helmet.base_fine_text} (${shortSection(helmet.mva_section)}).`
    });
  }
}
---
{props.type === 'offence' && (
  <Base
    title={offenceTitleStr}
    brandSuffix={false}
    description={`The ${lowerSeoName(props.offence.seo_name)} is ${amountInline} under ${shortSection(props.offence.mva_section)} of the Motor Vehicles Act — first and repeat offence amounts, licence impact and how to pay.`}
    path={`/fines/${props.offence.slug}/`}
    jsonld={[faqJsonLd(props.offence.faqs)]}
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Fines', path: '/fines/' }, { name: props.offence.name, path: `/fines/${props.offence.slug}/` }]}
    dateModified={props.offence.last_verified}
  >
    <h1>{offenceTitleStr}</h1>
    <AnswerBox>
      The fine for {props.offence.name.toLowerCase()} is {props.offence.base_fine_text} for a first offence
      ({shortSection(props.offence.mva_section)}).
    </AnswerBox>
    <p>A repeat offence costs {props.offence.repeat_fine_text}. {props.offence.licence_impact}</p>
    <LastVerified date={props.offence.last_verified} />

    <h2 id={slugify('What the law says')}>What does the law say about {props.offence.name.toLowerCase()}?</h2>
    <p>{props.offence.description}</p>
    {props.offence.statute_quote && (
      <blockquote class="statute">
        "{props.offence.statute_quote.text}"
        <cite>— {props.offence.statute_quote.attribution}</cite>
      </blockquote>
    )}

    <h2 id={slugify('Fine amounts')}>How much is the fine?</h2>
    <div class="table-wrap"><table>
      <caption>{props.offence.seo_name}: first and repeat offence amounts, {year}</caption>
      <thead><tr><th></th><th>Amount</th></tr></thead>
      <tbody>
        <tr><td>First offence</td><td>{props.offence.base_fine_text}</td></tr>
        <tr><td>Repeat offence</td><td>{props.offence.repeat_fine_text}</td></tr>
        <tr><td>Licence impact</td><td>{props.offence.licence_impact}</td></tr>
        <tr><td>Payable online</td><td>{props.offence.compoundable_online ? 'Yes, on official e-challan portals' : 'Usually requires court appearance'}</td></tr>
      </tbody>
    </table></div>

    {!props.offence.compoundable_online && (
      <CautionCallout>
        This is not an online-payable challan in most cases. {props.offence.name} cases generally go to
        court — budget for a court appearance, and check your state page for the exact process.
      </CautionCallout>
    )}

    {overriding.length > 0 && <>
      <h2 id={slugify('States with different notified amounts')}>Which states charge different amounts?</h2>
      <div class="table-wrap"><table>
        <caption>{props.offence.seo_name} by state, {year}</caption>
        <thead><tr><th>State</th><th>Amount</th></tr></thead>
        <tbody>{overriding.map((s) => <tr>
          <td><a href={`/${s.slug}-e-challan/`}>{s.name}</a></td>
          <td>{s.fine_overrides[props.offence.slug].amount_text}</td>
        </tr>)}</tbody>
      </table></div>
    </>}

    <RelatedLinks items={relatedForOffence(props.offence, states, guideRefs)} />
    <FaqSection faqs={props.offence.faqs} />
    <SourceList sources={props.offence.sources} />
  </Base>
)}
{props.type === 'state' && (
  <Base
    title={fineListTitle(props.state.name, props.state.abbr, year)}
    brandSuffix={false}
    description={`Every Motor Vehicles Act offence with the challan amount as it applies in ${props.state.name} (${props.state.abbr}): ${listOverridden.length} ${props.state.name}-notified amounts with official sources; the rest follow the statutory schedule.`}
    path={`/fines/${props.state.slug}/`}
    jsonld={[faqJsonLd(listFaqs)]}
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Fines', path: '/fines/' }, { name: `${props.state.name} fines list`, path: `/fines/${props.state.slug}/` }]}
    dateModified={listDate}
  >
    <h1>{fineListH1(props.state.name, props.state.abbr)}</h1>
    <AnswerBox>
      The table below lists {listRows.length} Motor Vehicles Act offences with the fine payable in {props.state.name}.
      {props.state.name} has notified its own amounts for {listOverridden.length} of them; the rest follow the
      statutory Motor Vehicles Act schedule.
    </AnswerBox>
    <p>
      Rows tagged "State-notified" carry the amount {props.state.name} has notified, with the official source linked
      under Sources below. Rows without the tag show the statutory Motor Vehicles Act amount — we have not verified a
      separate {props.state.name} schedule for those offences.
    </p>
    <LastVerified date={listDate} />

    <h2 id={slugify(`Traffic fines in ${props.state.name}`)}>How much is each traffic fine in {props.state.name}?</h2>
    <div class="table-wrap"><table class="schedule">
      <caption>Traffic fines in {props.state.name}, {year}</caption>
      <thead><tr><th>Offence</th><th>Fine in {props.state.name}</th><th>Legal basis</th></tr></thead>
      <tbody>
        {listRows.map((r) => (
          <tr id={r.slug}>
            <td><a href={`/fines/${r.slug}/`}>{r.name}</a></td>
            <td class="amount-cell" data-label={`Fine in ${props.state.name}`} data-override={r.overridden ? 'true' : 'false'}>
              {r.amountText}
              {r.overridden
                ? <span class="tag tag--attention">State-notified</span>
                : <span class="cell-note">Statutory amount — {props.state.name}'s own schedule not verified</span>}
            </td>
            <td data-label="Legal basis">{r.section}</td>
          </tr>
        ))}
      </tbody>
    </table></div>
    <p>
      Select any offence for the statutory first and repeat amounts, licence consequences and how every state varies
      from the central schedule.
    </p>

    <RelatedLinks items={relatedForFineList(props.state)} />
    <FaqSection faqs={listFaqs} />
    <SourceList sources={listSources} />
  </Base>
)}
