---
import Base from '../../layouts/Base.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import FineTable from '../../components/FineTable.astro';
import { loadOffences, newestVerifiedDate } from '../../lib/data';
import { datasetJsonLd } from '../../lib/seo';

const offences = loadOffences();
const newest = newestVerifiedDate();
const year = new Date().getFullYear();
---
<Base
  title={`Traffic Challan Rate List ${year}: All Fines & Penalties`}
  description={`Traffic challan rate list ${year}: every fine under the Motor Vehicles Act — offence, section, first and repeat penalty. Sourced and independently verified.`}
  path="/fines/"
  jsonld={[datasetJsonLd(
    'Indian traffic fine schedule (MV Act, as amended)',
    'Offence-wise penalties under the Motor Vehicles Act with state variations, sourced from official notifications.',
    '/fines/',
    [
      { url: '/api/fines.json', encodingFormat: 'application/json' },
      { url: '/api/fines.csv', encodingFormat: 'text/csv' },
      { url: '/api/states.json', encodingFormat: 'application/json' }
    ]
  )]}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Fines', path: '/fines/' }]}
  dateModified={newest}
>
  <h1>Traffic challan rate list: every fine amount in India</h1>
  <AnswerBox>
    Traffic fines in India are set by the Motor Vehicles Act (amended 2019). Common penalties: riding
    without a helmet or driving without a licence or insurance run from ₹1,000 to ₹5,000 for a first
    offence.
  </AnswerBox>
  <p>
    Some states have notified different amounts — see the <a href="/compare/">state-by-state comparison</a>
    or each offence page below.
  </p>
  <p class="verified">Table last verified: {newest}</p>
  <FineTable offences={offences} />
  <p>Select any offence for the exact legal section, repeat-offence penalty, licence consequences and state-wise variations.</p>
  <p class="verified">
    Download this data: <a href="/api/fines.json">JSON</a> · <a href="/api/fines.csv">CSV</a> ·
    <a href="/api/states.json">state records (JSON)</a>. Free to reuse with attribution to TrafficChallan.
  </p>
</Base>
