---
import Base from '../../layouts/Base.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import LastVerified from '../../components/LastVerified.astro';
import SourceList from '../../components/SourceList.astro';
import FaqSection from '../../components/FaqSection.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import CautionCallout from '../../components/CautionCallout.astro';
import { loadStates, loadOffences } from '../../lib/data';
import { faqJsonLd, offenceTitle, fineAmountShort, lowerSeoName } from '../../lib/seo';
import { shortSection, slugify } from '../../lib/format';
import { relatedForOffence } from '../../lib/links';
import type { OffenceRecord } from '../../lib/schemas';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return loadOffences().map((offence) => ({
    params: { offence: offence.slug },
    props: { offence }
  }));
}
interface Props { offence: OffenceRecord }
const { offence } = Astro.props;
const states = loadStates();
const overriding = states.filter((s) => offence.slug in s.fine_overrides);
const path = `/fines/${offence.slug}/`;
// Sorted by slug so the guide-link rotation in links.ts is stable across builds.
const guideRefs = (await getCollection('guides'))
  .map((g) => ({ slug: g.id, title: g.data.title }))
  .sort((a, b) => a.slug.localeCompare(b.slug));
const year = new Date().getFullYear();
const title = offenceTitle(offence.seo_name, offence.base_fine_min, offence.base_fine_max, year);
// Mid-sentence form of the compact amount ("Up to ₹10,000" → "up to ₹10,000").
const amountInline = fineAmountShort(offence.base_fine_min, offence.base_fine_max).replace(/^Up to/, 'up to');
---
<Base
  title={title}
  brandSuffix={false}
  description={`The ${lowerSeoName(offence.seo_name)} is ${amountInline} under ${shortSection(offence.mva_section)} of the Motor Vehicles Act — first and repeat offence amounts, licence impact and how to pay.`}
  path={path}
  jsonld={[faqJsonLd(offence.faqs)]}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Fines', path: '/fines/' }, { name: offence.name, path }]}
  dateModified={offence.last_verified}
>
  <h1>{title}</h1>
  <AnswerBox>
    The fine for {offence.name.toLowerCase()} is {offence.base_fine_text} for a first offence
    ({shortSection(offence.mva_section)}).
  </AnswerBox>
  <p>A repeat offence costs {offence.repeat_fine_text}. {offence.licence_impact}</p>
  <LastVerified date={offence.last_verified} />

  <h2 id={slugify('What the law says')}>What does the law say about {offence.name.toLowerCase()}?</h2>
  <p>{offence.description}</p>
  {offence.statute_quote && (
    <blockquote class="statute">
      "{offence.statute_quote.text}"
      <cite>— {offence.statute_quote.attribution}</cite>
    </blockquote>
  )}

  <h2 id={slugify('Fine amounts')}>How much is the fine?</h2>
  <div class="table-wrap"><table>
    <caption>{offence.seo_name}: first and repeat offence amounts, {year}</caption>
    <thead><tr><th></th><th>Amount</th></tr></thead>
    <tbody>
      <tr><td>First offence</td><td>{offence.base_fine_text}</td></tr>
      <tr><td>Repeat offence</td><td>{offence.repeat_fine_text}</td></tr>
      <tr><td>Licence impact</td><td>{offence.licence_impact}</td></tr>
      <tr><td>Payable online</td><td>{offence.compoundable_online ? 'Yes, on official e-challan portals' : 'Usually requires court appearance'}</td></tr>
    </tbody>
  </table></div>

  {!offence.compoundable_online && (
    <CautionCallout>
      This is not an online-payable challan in most cases. {offence.name} cases generally go to
      court — budget for a court appearance, and check your state page for the exact process.
    </CautionCallout>
  )}

  {overriding.length > 0 && <>
    <h2 id={slugify('States with different notified amounts')}>Which states charge different amounts?</h2>
    <div class="table-wrap"><table>
      <caption>{offence.seo_name} by state, {year}</caption>
      <thead><tr><th>State</th><th>Amount</th></tr></thead>
      <tbody>{overriding.map((s) => <tr>
        <td><a href={`/${s.slug}-e-challan/`}>{s.name}</a></td>
        <td>{s.fine_overrides[offence.slug].amount_text}</td>
      </tr>)}</tbody>
    </table></div>
  </>}

  <RelatedLinks items={relatedForOffence(offence, states, guideRefs)} />
  <FaqSection faqs={offence.faqs} />
  <SourceList sources={offence.sources} />
</Base>
