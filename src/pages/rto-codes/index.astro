---
import Base from '../../layouts/Base.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import FaqSection from '../../components/FaqSection.astro';
import LastVerified from '../../components/LastVerified.astro';
import ShareBar from '../../components/ShareBar.astro';
import { loadRtoFiles, loadStates } from '../../lib/data';
import { faqJsonLd, datasetJsonLd } from '../../lib/seo';
import { slugify } from '../../lib/format';
import { rtoStateHref } from '../../lib/rto-hub';

const rtoStates = [...loadRtoFiles()].sort((a, b) => a.state_name.localeCompare(b.state_name));
const siteStateSlugs = [...new Set(loadStates().map((s) => s.slug))];

const totalCodes = rtoStates.reduce((n, r) => n + r.codes.length, 0);
const lastVerified = rtoStates.map((r) => r.last_verified).sort().at(-1)!;
const codeCount = new Intl.NumberFormat('en-IN').format(totalCodes);

const prettyDate = (d: string) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

const faqs = [
  {
    q: 'What is an RTO code?',
    a: 'It is the first half of an Indian number plate: two letters for the state or union territory and two digits for the Regional Transport Office that registered the vehicle — MH12 is Pune, KA01 is Bengaluru Central, DL05 is Shahdara in Delhi. The code tells you where the vehicle was registered, not where its owner lives today.'
  },
  {
    q: 'Why does my city have several RTO codes?',
    a: 'Big cities are split between multiple transport offices, each with its own code and zone. Mumbai alone has MH01 (Tardeo), MH02 (Andheri), MH03 (Wadala) and MH47 (Borivali), and Bengaluru has a dozen KA codes. New codes are added whenever a state carves out a new office, which is why the digits in a series keep climbing.'
  },
  {
    q: 'What is the BH series on a number plate?',
    a: 'BH is the all-India Bharat series introduced by the central government in August 2021 (notification G.S.R. 594(E)). The format is year, then BH, then a number and letters — 22 BH 1234 AA — with no state code at all. It is open to central and state government employees and to private-sector employees whose company has offices in four or more states or union territories, and a BH-registered vehicle does not need re-registration when its owner moves between states.'
  },
  {
    q: 'Are old TS and AP codes still valid?',
    a: 'Yes. A number plate keeps its series for the life of the registration, so TS plates issued before Telangana switched its new registrations to TG remain valid, exactly as AP plates issued before the state split remain valid. The same applies to DN09 plates from before Dadra and Nagar Haveli merged with Daman and Diu — new registrations there use the DD series.'
  }
];

// Everything the lookup island needs, embedded at build time. Escape "<" so
// the JSON can never close the <script> tag early ("</script>" injection).
const islandData = {
  states: rtoStates.map((r) => ({
    slug: r.slug,
    state_name: r.state_name,
    series: r.series,
    codes: r.codes
  })),
  siteSlugs: siteStateSlugs
};
const islandJson = JSON.stringify(islandData).replace(/</g, '\\u003c');

const jsonld = [
  faqJsonLd(faqs),
  datasetJsonLd(
    'Indian RTO code directory — all states and union territories',
    `Every Regional Transport Office code in India (${codeCount} codes across ${rtoStates.length} states and union territories) with the registering office each code belongs to, verified against official state transport department lists where published and against sampled independent directories elsewhere, with per-state sources and last-verified dates.`,
    '/rto-codes/',
    [{ url: '/api/rto-codes.json', encodingFormat: 'application/json' }]
  )
];
---
<Base
  title="RTO Code List India: Which City Is That Number Plate From?"
  description={`Type any Indian number plate to see which city and RTO it is from — the full list of ${codeCount} RTO codes across ${rtoStates.length} states and union territories, verified and dated.`}
  path="/rto-codes/"
  jsonld={jsonld}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'RTO code lookup', path: '/rto-codes/' }]}
  dateModified={lastVerified}
>
  <h1>RTO code lookup: which city is that number plate from?</h1>
  <AnswerBox>
    The first two letters of an Indian number plate name the state or union territory, and the two digits after
    them name the exact office that registered the vehicle — MH12 is Pune, TG09 is Hyderabad Central, DL05 is
    Shahdara.
  </AnswerBox>
  <p>
    Type any plate or code into the lookup below to decode it on the spot, or open your state in the directory
    below for its full code list — {codeCount} codes across {rtoStates.length} states and union territories.
  </p>
  <LastVerified date={lastVerified} />

  <section class="panel">
    <h2 id={slugify('Find the RTO from a number plate')}>Find the RTO from a number plate</h2>
    <form id="rto-form" class="finder-form">
      <label for="rto-input">Number plate or RTO code</label>
      <input type="text" id="rto-input" autocomplete="off" placeholder="MH12AB1234 or MH12" />
      <button type="submit" class="action action--primary">Look up</button>
    </form>
    <p class="verified">Checks run in your browser — nothing you type leaves this page.</p>
    <div id="rto-result" class="finder-result" aria-live="polite"></div>
    <noscript>
      <p>The lookup needs JavaScript — without it, open your state's code list from the directory below.</p>
    </noscript>
  </section>

  <h2 id={slugify('RTO code lists by state and union territory')}>RTO code lists by state and union territory</h2>
  <p>
    Open a state for its full code table — every code with its registering office, how that state's list was
    verified, and the sources it was checked against.
  </p>
  <div class="table-wrap">
    <table class="schedule">
      <caption>RTO code lists by state and union territory</caption>
      <thead>
        <tr>
          <th scope="col">State / UT</th>
          <th scope="col">Series</th>
          <th scope="col">Codes</th>
          <th scope="col">Last verified</th>
        </tr>
      </thead>
      <tbody>
        {rtoStates.map((r) => (
          <tr>
            <td><a href={rtoStateHref(r.slug)}>{r.state_name}</a></td>
            <td data-label="Series">{r.series.join(', ')}</td>
            <td data-label="Codes">{r.codes.length}</td>
            <td data-label="Last verified"><time datetime={r.last_verified}>{prettyDate(r.last_verified)}</time></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <FaqSection faqs={faqs} />

  <ShareBar text="Which city is that number plate from? Full RTO code lookup — trafficchallan.com" />

  <script type="application/json" id="rto-data" set:html={islandJson} />
  <script>
    import { lookupRto, type RtoLookupState } from '../../lib/rto-lookup';
    import { rtoStateHref, rtoCodeHref } from '../../lib/rto-hub';

    interface RtoIslandData { states: RtoLookupState[]; siteSlugs: string[] }
    const data: RtoIslandData = JSON.parse(document.getElementById('rto-data')!.textContent!);
    const siteSlugs = new Set(data.siteSlugs);

    const form = document.getElementById('rto-form') as HTMLFormElement;
    const input = document.getElementById('rto-input') as HTMLInputElement;
    const result = document.getElementById('rto-result') as HTMLDivElement;

    function panel(): HTMLDivElement {
      result.replaceChildren();
      const wrap = document.createElement('div');
      wrap.className = 'panel';
      result.appendChild(wrap);
      return wrap;
    }

    function p(wrap: HTMLElement, text: string) {
      const el = document.createElement('p');
      el.textContent = text;
      wrap.appendChild(el);
      return el;
    }

    function stateLinks(wrap: HTMLElement, state: { slug: string; state_name: string }, code?: string) {
      const line = document.createElement('p');
      if (code) {
        const codeLink = document.createElement('a');
        codeLink.href = rtoCodeHref(state.slug, code);
        codeLink.textContent = `${code} in the ${state.state_name} code list`;
        line.appendChild(codeLink);
        line.appendChild(document.createTextNode(' · '));
      }
      const all = document.createElement('a');
      all.href = rtoStateHref(state.slug);
      all.textContent = `All ${state.state_name} codes`;
      line.appendChild(all);
      if (siteSlugs.has(state.slug)) {
        line.appendChild(document.createTextNode(' · '));
        const challan = document.createElement('a');
        challan.href = `/${state.slug}-e-challan/`;
        challan.textContent = `Check pending challans in ${state.state_name}`;
        line.appendChild(challan);
      }
      wrap.appendChild(line);
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const r = lookupRto(input.value, data.states);
      const wrap = panel();

      if (r.kind === 'code') {
        const h3 = document.createElement('h3');
        h3.textContent = `${r.code} — ${r.office}, ${r.state.state_name}`;
        wrap.appendChild(h3);
        p(wrap, `A ${r.code} plate was registered at the ${r.office} office in ${r.state.state_name}.`);
        stateLinks(wrap, r.state, r.code);
      } else if (r.kind === 'state') {
        const h3 = document.createElement('h3');
        h3.textContent = `${r.series} — ${r.state.state_name}`;
        wrap.appendChild(h3);
        p(
          wrap,
          `${r.series} plates are registered in ${r.state.state_name}, which has ${r.codes_count} RTO code${r.codes_count === 1 ? '' : 's'}. ` +
            "If you typed a code with a number we do not list, it may be newly created — the state's code list page has every code we have verified."
        );
        stateLinks(wrap, r.state);
      } else if (r.kind === 'bh') {
        const h3 = document.createElement('h3');
        h3.textContent = 'BH — Bharat series (all-India)';
        wrap.appendChild(h3);
        p(
          wrap,
          'BH plates carry no state code: the format is year + BH + number (e.g. 22 BH 1234 AA). The series is open to central and state government employees and to private-sector employees whose company has offices in four or more states, and the vehicle needs no re-registration when its owner moves between states.'
        );
      } else {
        p(wrap, "We couldn't recognise that — try a full number plate like MH12AB1234, or a code like MH12.");
      }
    });
  </script>
</Base>
