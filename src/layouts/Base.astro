---
import '../styles/global.css';
import { orgJsonLd, websiteJsonLd, breadcrumbJsonLd, webPageJsonLd, ORIGIN } from '../lib/seo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { loadStates } from '../lib/data';
import { getCollection } from 'astro:content';

interface Props {
  title: string; description: string; path: string;
  jsonld?: object[]; breadcrumbs?: { name: string; path: string }[];
  /** ISO date (YYYY-MM-DD) — when present, emits a WebPage JSON-LD node with
   * dateModified/lastReviewed set to it. See src/lib/seo.ts#webPageJsonLd. */
  dateModified?: string;
  /** When false, the <title> drops the " | TrafficChallan" suffix. Pass false
   * from pages whose titles already fill the SERP budget with distinguishing
   * query language (state pages, fine pages) or already carry the brand
   * (/about/); homepage, guides and feature pages keep the suffix. */
  brandSuffix?: boolean;
}
const { title, description, path, jsonld = [], breadcrumbs, dateModified, brandSuffix = true } = Astro.props;
const canonical = ORIGIN + path;
const blocks = [
  orgJsonLd(),
  websiteJsonLd(),
  ...(breadcrumbs ? [breadcrumbJsonLd(breadcrumbs)] : []),
  ...(dateModified ? [webPageJsonLd(path, title, dateModified)] : []),
  ...jsonld
];

const footerStates = [...loadStates()].sort((a, b) => a.name.localeCompare(b.name));
const footerGuides = (await getCollection('guides'))
  .map((g) => ({ href: `/${g.id}/`, label: g.data.title }))
  .sort((a, b) => a.label.localeCompare(b.label));
---
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{brandSuffix ? `${title} | TrafficChallan` : title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ORIGIN + '/og-default.png'} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/anek-latin-var.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/plex-sans-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/plex-sans-var-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
  {blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
</head>
<body>
  <!-- Cloudflare's Email Address Obfuscation rewrites every email-looking
       string into a /cdn-cgi/l/email-protection pseudo-link that 404s for
       non-JS crawlers (flagged as broken links in site audits). Every email
       on this site is a public helpdesk/contact address, so obfuscation is
       disabled for the whole body with Cloudflare's documented toggle. -->
  <!--email_off-->
  <!-- Anti-impersonation notice. Deliberately plain: no board, no blue, no
       crest. It must not read as an official notice. -->
  <div class="notice-strip">
    <p><strong>Independent guide</strong> — not a government website. Challans are paid only on official government portals.</p>
  </div>

  <header class="site-header">
    <div class="inner">
      <a href="/" class="brand">
        <!-- Sign-Slip mark: guide-sign board tearing into a receipt zigzag.
             Fills are fixed (not currentColor) — the board blue must survive
             sitting on the blue header band, helped by the CSS outer keyline. -->
        <svg class="brand__mark" width="26" height="26" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <path class="brand__mark-board" d="M6 0h20q6 0 6 6v22l-4 3-4-3-4 3-4-3-4 3-4-3-4 3-4-3V6q0-6 6-6Z" fill="#0A3D7C"/>
          <path d="M6.5 3h19Q29 3 29 6.5v20.75l-1 .75-4-3-4 3-4-3-4 3-4-3-4 3-1-.75V6.5Q3 3 6.5 3Z" fill="none" stroke="#fff" stroke-width="2" stroke-opacity=".9"/>
          <text x="16" y="19" style="font-family:inherit" font-size="16" font-weight="700" fill="#fff" text-anchor="middle">₹</text>
        </svg>
        TrafficChallan<span class="brand__tld">.com</span>
      </a>
      <div id="search-slot">
        <button type="button" id="search-open" class="search-btn" aria-haspopup="dialog" aria-controls="search-dialog">
          <svg class="search-btn__icon" width="15" height="15" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <circle cx="7" cy="7" r="5.1" fill="none" stroke="currentColor" stroke-width="1.6" />
            <line x1="11" y1="11" x2="14.6" y2="14.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          Search
        </button>
        <dialog id="search-dialog" class="search-dialog" aria-label="Search TrafficChallan">
          <div class="search-dialog__head">
            <label for="search-input" class="sr-only">Search states, fines and guides</label>
            <input type="search" id="search-input" placeholder="Search states, fines, guides…" autocomplete="off" />
            <button type="button" id="search-close" class="search-close" aria-label="Close search">&times;</button>
          </div>
          <div id="search-results" class="search-results" aria-live="polite"></div>
        </dialog>
      </div>
      <nav class="site-nav" aria-label="Primary">
        <a href="/fines/">Fines &amp; Penalties</a>
        <a href="/calculator/">Calculator</a>
        <a href="/challan-discount/">Discounts</a>
        <a href="/about/">About</a>
      </nav>
    </div>
  </header>
  <main data-pagefind-body>
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    <slot />
    <p class="disclaimer" data-pagefind-ignore>TrafficChallan.com is an independent information website, not affiliated with any government body. Challan payments happen only on official government portals we link to.</p>
  </main>
  <footer class="site-footer">
    <div class="inner">
      <nav class="footer-nav" aria-label="Footer">
        <div>
          <h2>States</h2>
          <ul>{footerStates.map((s) => <li><a href={`/${s.slug}-e-challan/`}>{s.name}</a></li>)}</ul>
        </div>
        <div>
          <h2>Fines &amp; tools</h2>
          <ul>
            <li><a href="/fines/">Fines &amp; Penalties</a></li>
            <li><a href="/calculator/">Fine calculator</a></li>
            <li><a href="/challan-discount/">Challan discount tracker</a></li>
            <li><a href="/rto-codes/">RTO code lookup</a></li>
            <li><a href="/challan-status/">Challan status decoder</a></li>
            <li><a href="/echallan-parivahan/">eChallan Parivahan portal directory</a></li>
            <li><a href="/fake-challan-sms/">Fake challan SMS check</a></li>
            <li><a href="/data/">Open data &amp; API</a></li>
            {footerGuides.map((g) => <li><a href={g.href}>{g.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>About this site</h2>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/editorial-policy/">Editorial policy</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
      </nav>
      <p class="colophon">© {new Date().getFullYear()} TrafficChallan<span class="brand__tld">.com</span> · By Team TrafficChallan ·
        <a href="/editorial-policy/">Editorial policy</a> · <a href="/privacy/">Privacy</a> · <a href="/contact/">Contact</a></p>
    </div>
  </footer>

  <script>
    // Pagefind-backed site search. The index only exists post-build
    // (`pagefind --site dist`), so pagefind.js is imported lazily on first
    // open — zero bytes for the ~95% of visitors who never search, and a
    // graceful message in dev where /pagefind/ doesn't exist yet.
    const openBtn = document.getElementById('search-open') as HTMLButtonElement | null;
    const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('search-close') as HTMLButtonElement | null;
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const results = document.getElementById('search-results') as HTMLDivElement | null;

    if (openBtn && dialog && closeBtn && input && results) {
      let pagefind: any = null;
      let pagefindFailed = false;
      let requestId = 0;

      async function loadPagefind() {
        if (pagefind || pagefindFailed) return pagefind;
        try {
          // Path only exists in the built dist/ output, generated by the
          // `pagefind --site dist` build step — never bundled by us. The
          // specifier is built at runtime (not a string literal) so Rollup
          // cannot try to statically resolve it during `astro build`.
          const pagefindEntry = ['', 'pagefind', 'pagefind.js'].join('/');
          pagefind = await import(/* @vite-ignore */ pagefindEntry);
        } catch {
          pagefindFailed = true;
        }
        return pagefind;
      }

      function renderNote(text: string) {
        results!.replaceChildren();
        const p = document.createElement('p');
        p.className = 'search-note';
        p.textContent = text;
        results!.appendChild(p);
      }

      async function runSearch(query: string) {
        const thisRequest = ++requestId;
        if (!query.trim()) {
          results!.replaceChildren();
          return;
        }
        const pf = await loadPagefind();
        if (!pf) {
          renderNote('Search available on the live site.');
          return;
        }
        const search = await pf.debouncedSearch(query);
        if (!search || thisRequest !== requestId) return; // superseded by a newer keystroke
        if (search.results.length === 0) {
          renderNote('No results.');
          return;
        }
        const top = search.results.slice(0, 8);
        const items = await Promise.all(top.map((r: any) => r.data()));
        if (thisRequest !== requestId) return;
        results!.replaceChildren();
        for (const item of items) {
          const row = document.createElement('div');
          row.className = 'search-result';
          const a = document.createElement('a');
          a.href = item.url;
          a.textContent = item.meta?.title || item.url;
          row.appendChild(a);
          const excerpt = document.createElement('p');
          excerpt.className = 'search-result__excerpt';
          // result.excerpt is pre-highlighted HTML generated by Pagefind
          // from our own static page content — the one sanctioned innerHTML
          // use on the site.
          excerpt.innerHTML = item.excerpt;
          row.appendChild(excerpt);
          results!.appendChild(row);
        }
      }

      function openDialog() {
        dialog!.showModal();
        input!.focus();
      }

      openBtn.addEventListener('click', openDialog);
      closeBtn.addEventListener('click', () => dialog!.close());
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog!.close();
      });
      dialog.addEventListener('close', () => {
        results!.replaceChildren();
        input!.value = '';
      });

      // pagefind's own debouncedSearch (called inside runSearch) already
      // debounces and supersedes stale in-flight searches — no extra
      // setTimeout wrapper needed here.
      input.addEventListener('input', () => runSearch(input!.value));

      // '/' opens search from anywhere on the page unless focus is already
      // in a text field; native <dialog> handles Escape-to-close itself.
      document.addEventListener('keydown', (e) => {
        if (e.key !== '/' || dialog!.open) return;
        const active = document.activeElement as HTMLElement | null;
        const tag = active?.tagName;
        const isEditable = tag === 'INPUT' || tag === 'TEXTAREA' || active?.isContentEditable;
        if (!isEditable) {
          e.preventDefault();
          openDialog();
        }
      });
    }
  </script>
  <!--email_on-->
</body>
</html>
